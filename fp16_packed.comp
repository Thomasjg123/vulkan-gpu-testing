// Optimized FP16 compute benchmark.
//
// The baseline fp16.comp uses scalar float16_t, which executes at the same
// rate as FP32 on most GPUs (one FMA per lane per cycle). This shader uses
// f16vec2, so the compiler emits packed half2 FMAs (v_pk_fma_f16 on AMD),
// doing two FP16 FMAs per instruction and reaching the 2:1 FP16 rate.
//
// Tuning that mattered on an RX 6600 XT (Navi 23):
//   - 32 independent f16vec2 accumulators = 64 in-flight FMAs, enough ILP
//     to hide FMA latency without exhausting registers.
//   - unroll 8: amortizes the loop counter/compare/branch overhead.
//   - local_size_x = 512: best occupancy on this GPU.
//   - 64 FP16 FMAs per thread per iteration (32 f16vec2).

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 512) in;

layout(set = 0, binding = 0, std430) buffer Results {
	float result[];
};

layout(push_constant) uniform Parameters {
	uint iterations;
} params;

