#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer Results {
	float result[];
};

layout(push_constant) uniform Parameters {
	uint iterations;
} params;

void main()
{
	uint id = gl_GlobalInvocationID.x;

	//Eight independent FP16 accumulators
	float16_t a = float16_t(0.1);
        float16_t b = float16_t(0.2);
        float16_t c = float16_t(0.3);
        float16_t d = float16_t(0.4);
        float16_t e = float16_t(0.5);
        float16_t f = float16_t(0.6);
        float16_t g = float16_t(0.7);
        float16_t h = float16_t(0.8);

	float16_t multiplier = float16_t(0.999);
	float16_t addition = float16_t(0.001);

	for(uint i = 0; i < params.iterations; i++)
	{
		a = fma(a, multiplier, addition);
                b = fma(b, multiplier, addition);
                c = fma(c, multiplier, addition);
                d = fma(d, multiplier, addition);
                e = fma(e, multiplier, addition);
                f = fma(f, multiplier, addition);
                g = fma(g, multiplier, addition);
                h = fma(h, multiplier, addition);
	}
	//write results so the computation has observavale output
	result[id] = float(a + b + c + d + e + f + g + h);
}

